{
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "plugins": ["@babel/plugin-syntax-flow", "@babel/plugin-syntax-jsx"]
    }
  },
  "plugins": ["flowtype", "fb-flow"],
  "rules": {
    "flowtype/no-weak-types": "warn",
    "fb-flow/use-indexed-access-type": "warn",
    "no-warning-comments": [
      "error",
      {
        "terms": ["flow-typed signature", "flow-typed version"],
        "location": "start"
      }
    ]
  }
}
